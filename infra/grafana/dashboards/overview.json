    {
      "id": 19,
      "type": "timeseries",
      "title": "Postgres connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 56 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (datname) (pg_stat_database_numbackends{datname=~\"db_.*\"})",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Postgres transactions per second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 56 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (datname) (rate(pg_stat_database_xact_commit{datname=~\"db_.*\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} commit"
        },
        {
          "refId": "B",
          "expr": "max by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"db_.*\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} rollback"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Postgres cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 56 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=~\"db_.*\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{datname=~\"db_.*\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=~\"db_.*\"}[$__rate_interval]))) or vector(100)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Postgres lock waits by mode",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 64 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (max by (datname, mode) (pg_locks_count{datname=~\"db_.*\"}))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Postgres deadlocks and temp files",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 64 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
