        },
        {
          "refId": "B",
          "expr": "max by (datname) (rate(pg_stat_database_temp_files{datname=~\"db_.*\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} temp files"
        }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Postgres database size",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 64 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (datname) (pg_database_size_bytes{datname=~\"db_.*\"})",
          "legendFormat": "{{datname}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 25,
      "type": "table",
      "title": "Slowest statements (pg_stat_statements)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 72 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "mean ms", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, (max by (datname, queryid) ((rate(pg_stat_statements_seconds_total{user!=\"exporter\"}[$__rate_interval]) / rate(pg_stat_statements_calls_total{user!=\"exporter\"}[$__rate_interval])) > 0)) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)) * 1000",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "queryid": true },
            "renameByName": { "datname": "database", "query": "statement", "Value": "mean ms" }
          }
        }
      ]
