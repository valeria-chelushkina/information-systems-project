{
  "uid": "concert-ops-postgres",
  "title": "Postgres",
  "tags": ["concert-ops", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    { "type": "dashboards", "tags": ["concert-ops"], "asDropdown": true, "includeVars": true, "keepTime": true, "title": "Dashboards" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "iconColor": "orange",
        "name": "Load tests",
        "target": { "limit": 100, "matchAny": false, "tags": ["load-test"], "type": "tags" },
        "type": "tags"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(pg_stat_database_numbackends{datname=~\"db_.*\"}, datname)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "db_.*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connections by database",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (datname) (pg_stat_database_numbackends{datname=~\"$datname\"})",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connections used (worst database)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "max(postgres:connections:percent{datname=~\"$datname\"})", "instant": true, "range": false }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transactions per second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (datname) (rate(pg_stat_database_xact_commit{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} commit"
        },
        {
          "refId": "B",
          "expr": "max by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} rollback"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "postgres:cache_hit:percent5m or vector(100)", "instant": true, "range": false }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Locks held by mode",
      "description": "pg_locks_count counts locks held, not sessions waiting",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (max by (datname, mode) (pg_locks_count{datname=~\"$datname\"})) > 0",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Deadlocks and temp files",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (datname) (rate(pg_stat_database_deadlocks{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} deadlocks"
        },
        {
          "refId": "B",
          "expr": "max by (datname) (rate(pg_stat_database_temp_files{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}} temp files"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Database size",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (datname) (pg_database_size_bytes{datname=~\"$datname\"})",
          "legendFormat": "{{datname}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Slowest statements (pg_stat_statements)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "mean ms", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, (max by (datname, queryid) ((rate(pg_stat_statements_seconds_total{user!=\"exporter\",datname=~\"$datname\"}[$__rate_interval]) / rate(pg_stat_statements_calls_total{user!=\"exporter\",datname=~\"$datname\"}[$__rate_interval])) > 0)) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)) * 1000",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "queryid": true },
            "renameByName": { "datname": "database", "query": "statement", "Value": "mean ms" }
          }
        }
      ]
    }
  ]
}
