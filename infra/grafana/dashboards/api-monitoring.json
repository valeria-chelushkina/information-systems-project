{
  "uid": "concert-ops-api",
  "title": "API Monitoring",
  "tags": ["concert-ops", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    { "type": "dashboards", "tags": ["concert-ops"], "asDropdown": true, "includeVars": true, "keepTime": true, "title": "Dashboards" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "iconColor": "orange",
        "name": "Load tests",
        "target": { "limit": 100, "matchAny": false, "tags": ["load-test"], "type": "tags" },
        "type": "tags"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "sort": 1
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, method)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "90th / 95th / 99th response time by method",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.90, sum by (le, method) (rate(http_request_duration_seconds_bucket{service=~\"$service\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": "p90 {{method}}"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, method) (rate(http_request_duration_seconds_bucket{service=~\"$service\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": "p95 {{method}}"
        },
        {
          "refId": "C",
          "expr": "1000 * histogram_quantile(0.99, sum by (le, method) (rate(http_request_duration_seconds_bucket{service=~\"$service\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": "p99 {{method}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Slowest routes by average response time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(6, 1000 * sum by (route, method) (rate(http_request_duration_seconds_sum{service=~\"$service\",method=~\"$method\"}[$__rate_interval])) / sum by (route, method) (rate(http_request_duration_seconds_count{service=~\"$service\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Requests by route (selected range)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 80, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "xField": "route",
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "auto",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(topk(12, (sum by (route) (increase(http_requests_total{service=~\"$service\",method=~\"$method\"}[$__range]))) > 0))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per minute",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 40, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=~\"$service\",method=~\"$method\"}[$__rate_interval])) * 60",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failed requests per minute",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=~\"$service\",method=~\"$method\",status=~\"4..\"}[$__rate_interval])) * 60",
          "legendFormat": "4xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_requests_total{service=~\"$service\",method=~\"$method\",status=~\"5..\"}[$__rate_interval])) * 60",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "2xx OK vs errors per minute",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "errors" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=~\"$service\",method=~\"$method\",status=~\"2..\"}[$__rate_interval])) * 60",
          "legendFormat": "2xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_requests_total{service=~\"$service\",method=~\"$method\",status!~\"2..\"}[$__rate_interval])) * 60",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Route statistics",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "requests" },
            "properties": [{ "id": "unit", "value": "short" }]
          },
          {
            "matcher": { "id": "byName", "options": "5xx %" },
            "properties": [{ "id": "unit", "value": "percent" }]
          },
          {
            "matcher": { "id": "byName", "options": "avg ms" },
            "properties": [{ "id": "unit", "value": "ms" }]
          },
          {
            "matcher": { "id": "byName", "options": "p95 ms" },
            "properties": [{ "id": "unit", "value": "ms" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "requests", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (route) (increase(http_requests_total{service=~\"$service\",method=~\"$method\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(100 * sum by (route) (increase(http_requests_total{service=~\"$service\",method=~\"$method\",status=~\"5..\"}[$__range])) / sum by (route) (increase(http_requests_total{service=~\"$service\",method=~\"$method\"}[$__range]))) or (sum by (route) (increase(http_requests_total{service=~\"$service\",method=~\"$method\"}[$__range])) * 0)",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "1000 * sum by (route) (increase(http_request_duration_seconds_sum{service=~\"$service\",method=~\"$method\"}[$__range])) / sum by (route) (increase(http_request_duration_seconds_count{service=~\"$service\",method=~\"$method\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, route) (increase(http_request_duration_seconds_bucket{service=~\"$service\",method=~\"$method\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "route", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": {
              "route": "route",
              "Value #A": "requests",
              "Value #B": "5xx %",
              "Value #C": "avg ms",
              "Value #D": "p95 ms"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "requests",
                "config": { "id": "greater", "options": { "value": 0 } }
              }
            ]
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Status code breakdown",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "requests" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "requests", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(http_requests_total{service=~\"$service\",method=~\"$method\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": { "status": "status", "Value": "requests" }
          }
        }
      ]
    }
  ]
}
