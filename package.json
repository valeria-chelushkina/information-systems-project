{
  "name": "concert-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Concert operations platform with Prometheus/Grafana/Loki/Tempo observability",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio --config=src/db/drizzle.config.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.1.4",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
