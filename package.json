{
  "name": "concert-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Concert operations platform with Prometheus/Grafana/Loki/Tempo observability",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/services/ticketing/server.ts",
    "dev:catalog": "cross-env SERVICE_NAME=catalog CATALOG_PORT=3003 tsx watch src/services/catalog/server.ts",
    "dev:auth": "cross-env SERVICE_NAME=auth AUTH_PORT=3005 tsx watch src/services/auth/server.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/services/ticketing/server.js",
    "start:catalog": "cross-env SERVICE_NAME=catalog node dist/services/catalog/server.js",
    "start:auth": "cross-env SERVICE_NAME=auth node dist/services/auth/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=src/services/ticketing/db/drizzle.config.ts",
    "db:generate:catalog": "drizzle-kit generate --config=src/services/catalog/db/drizzle.config.ts",
    "db:migrate": "tsx src/shared/db/migrate.ts ticketing",
    "db:migrate:catalog": "tsx src/shared/db/migrate.ts catalog",
    "db:studio": "drizzle-kit studio --config=src/services/ticketing/db/drizzle.config.ts",
    "seed": "tsx src/services/ticketing/scripts/seed.ts",
    "seed:catalog": "cross-env SERVICE_NAME=catalog tsx src/services/catalog/scripts/seed.ts",
    "seed:auth": "cross-env SERVICE_NAME=auth tsx src/services/auth/scripts/seed.ts",
    "load": "tsx src/services/ticketing/scripts/load-purchases.ts"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.1.4",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
